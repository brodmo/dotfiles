[
  {
    "context": "Workspace",
    "bindings": {
      "cmd-r": "multi_workspace::ToggleWorkspaceSidebar",  // Repos
      "cmd-t": "terminal_panel::Toggle",                   // Terminal
      "cmd-s": "project_panel::Toggle",                    // Select
      "cmd-e": "workspace::FocusCenterPane",               // Editor
      "cmd-shift-t": "project_symbols::Toggle", // shadowed by terminal
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-[": "workspace::ActivatePaneLeft",
      "cmd-]": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "<": ["workspace::SendKeystrokes", "< g v"],
      ">": ["workspace::SendKeystrokes", "> g v"],
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "g l": ["task::Spawn", { "task_name": "lazygit" }],
      "h": ["workspace::SendKeystrokes", "ctrl-o"],    // History
      "j": ["workspace::SendKeystrokes", "ctrl-i"],    // Jump
      "k": ["workspace::SendKeystrokes", "\" _ d d"],  // Kill
      "l": "vim::FirstNonWhitespace",                  // Left
    },
  },
]
